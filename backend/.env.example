# Environment Configuration Template
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/manufacturing_db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Application
APP_NAME=Manufacturing Defect Traceability System
APP_VERSION=1.0.0
DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Initial Admin User
FIRST_ADMIN_EMAIL=admin@manufacturing.com
FIRST_ADMIN_PASSWORD=Admin@123456
